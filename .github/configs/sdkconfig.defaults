# Increase a bit these stack sizes as they are too low by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# For async-io (async-io-mini which is used by default does not need that)
#CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Go figure...
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# BT
CONFIG_BT_ENABLED=y

# The Bluetooth host to build against - flip these two to switch.
#
# `esp-idf-matter` provides a BTP GATT peripheral for either host, and picks the matching
# implementation off these options.
#
# NimBLE has a substantially smaller RAM footprint than Bluedroid, which is what allows BLE to
# coexist with Thread on the RAM-constrained esp32h2 and esp32c6. Bluedroid additionally
# supports BT Classic, which Matter does not use.
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# --- Bluedroid; only in effect with `CONFIG_BT_BLUEDROID_ENABLED=y` ---

CONFIG_BT_BTC_TASK_STACK_SIZE=8192
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_A2DP_ENABLE=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# Chips are RAM-tight with Thread+BLE+Matter, and commissioning BLE needs only a fraction of
# the default HCI transport pool. Counts below are trimmed from the defaults of 10 / 30 / 8,
# which together reserve ~14.6 KiB.
CONFIG_BT_LE_ACL_BUF_COUNT=4
CONFIG_BT_LE_HCI_EVT_HI_BUF_COUNT=8
CONFIG_BT_LE_HCI_EVT_LO_BUF_COUNT=4
# Matter commissions over a single BLE link
CONFIG_BT_LE_MAX_CONNECTIONS=1
CONFIG_BT_ACL_CONNECTIONS=1

# --- NimBLE; only in effect with `CONFIG_BT_NIMBLE_ENABLED=y` ---

# The Matter accessory role needs a GATT server advertised as a peripheral. The Commissioner role
# (`EspBtpGattClient`) additionally needs the central role + GATT client - set both to `y` to build
# it (it also needs an rs-matter with `Btp::set_initiator`; see the note in `Cargo.toml`).
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# BTP carries its own security on top of GATT, so BLE-level pairing and bonding are unused.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n

# None of NimBLE's bundled sample services are used by Matter.
CONFIG_BT_NIMBLE_ANS_SERVICE=n
CONFIG_BT_NIMBLE_BAS_SERVICE=n
CONFIG_BT_NIMBLE_CTS_SERVICE=n
CONFIG_BT_NIMBLE_DIS_SERVICE=n
CONFIG_BT_NIMBLE_HR_SERVICE=n
CONFIG_BT_NIMBLE_HTP_SERVICE=n
CONFIG_BT_NIMBLE_IAS_SERVICE=n
CONFIG_BT_NIMBLE_IPSS_SERVICE=n
CONFIG_BT_NIMBLE_LLS_SERVICE=n
CONFIG_BT_NIMBLE_PROX_SERVICE=n
CONFIG_BT_NIMBLE_SPS_SERVICE=n
CONFIG_BT_NIMBLE_TPS_SERVICE=n

# Generic Thread functionality
CONFIG_OPENTHREAD_ENABLED=y
# No interactive OpenThread console on a Matter device (the driver never starts it)
CONFIG_OPENTHREAD_CLI=n
# MANDATORY:
# Route IPv6 source-address selection on the Thread netif through OpenThread's own
# `otIp6SelectSourceAddress()`. The ESP-IDF OpenThread component implements the
# `lwip_hook_ip6_select_source_address` hook, but lwIP only calls it when this option
# selects a custom implementation - the default (`..._NONE`) leaves that hook dead code and
# lets lwIP pick a source address with no knowledge of Thread's address roles.
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y
# Optional:
# The default of 3 is exactly what a Thread node already consumes - link-local, mesh-local
# EID and one OMR address - leaving no room for a second on-mesh prefix in case the BR has one.
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
# Optional:
# Answer pings sent to multicast addresses - e.g. to probe a Thread node from off-mesh - `ping6 ff02::1`.
#CONFIG_LWIP_MULTICAST_PING=y
# Just in case
#CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# Wifi/Thread + BLE coex
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# So that the QR code does not get distorted by misaligned log lines
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y

# Colored terminal not enabled by default since ESP-IDF V5.5
CONFIG_LOG_COLORS=y
